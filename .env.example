# ── Paws Playcare environment ───────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).

# Database (SQLite file on the server's persistent disk).
# In production use an ABSOLUTE path OUTSIDE the deploy folder so redeploys
# don't wipe it, e.g. file:/var/www/vhosts/pawsplaycare.co.uk/data/prod.db
DATABASE_URL="file:./dev.db"

# Session signing secret — generate a fresh 32+ char random string for prod:
#   openssl rand -base64 32
AUTH_SECRET=""

# Public site URL (used in emails, sitemap, canonical links). No trailing slash.
# Production: https://pawsplaycare.co.uk
NEXT_PUBLIC_APP_URL="http://localhost:3010"

# ── Stripe ──────────────────────────────────────────────────────────────────
# TEST keys for building; swap to LIVE keys (sk_live_… / pk_live_…) at go-live.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From the Stripe webhook you create for this domain (whsec_…).
STRIPE_WEBHOOK_SECRET=""

# ── Cron auth ───────────────────────────────────────────────────────────────
# Shared secret the scheduler sends to /api/cron/* (Bearer or ?key=). Random 32+.
CRON_SECRET=""

# ── Email (Resend) — optional ───────────────────────────────────────────────
# Without RESEND_API_KEY, invoice/expiry emails are skipped (in-app only).
RESEND_API_KEY=""
# Verified sender once your domain is set up in Resend:
EMAIL_FROM="Paws Playcare <billing@pawsplaycare.co.uk>"
